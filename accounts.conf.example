# Copy to accounts.conf and enter your own account credentials.
# One [Name] section per account. Use any unique, case-sensitive name containing
# 1–64 letters, digits, spaces, dots, underscores or hyphens; start with a letter
# or digit and do not end with a space. Quote names containing spaces in commands:
# bash HGincome "Main Account" --start
# bash HGincome --start                  (all accounts)
# bash HGincome --accounts               (list names, slots and proxy files)
# Keep accounts.conf private: chmod 600 accounts.conf
# Values after the first = are literal. Do not add quotes or inline comments.
# Passwords may contain spaces, #, ;, =, $, quotes, and backslashes as-is.

[Main Account]
email=
password=
devices=10
proxy_file=proxies/main.txt
# Optional; default prefix uses a stable internal account ID:
# device_prefix=my-main-hg

[Second Account]
email=
password=
devices=10
proxy_file=proxies/second.txt
# device_prefix=my-second-hg

# Proxies are mandatory: one eligible, unique endpoint per device slot.
# Omit devices to use DEVICES_PER_ACCOUNT (10 by default).
# Omit proxy_file to use proxies/<Account Name>.txt.
# Use only authorized accounts/connections permitted by current service terms.
